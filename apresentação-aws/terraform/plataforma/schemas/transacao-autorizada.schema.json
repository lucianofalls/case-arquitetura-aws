{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "TransacaoAutorizadaV1",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "data"],
  "properties": {
    "specversion": {"type": "string", "enum": ["1.0"]},
    "id": {"type": "string"},
    "source": {"type": "string"},
    "type": {"type": "string", "enum": ["TransacaoAutorizada"]},
    "time": {"type": "string", "format": "date-time"},
    "datacontenttype": {"type": "string", "enum": ["application/json"]},
    "data": {
      "type": "object",
      "required": ["event_id", "id_autorizacao", "id_contrato", "valor", "saldo_reservado", "correlation_id"],
      "properties": {
        "event_id": {"type": "string"},
        "id_autorizacao": {"type": "string"},
        "id_contrato": {"type": "string"},
        "valor": {"type": "string"},
        "saldo_reservado": {"type": "string"},
        "correlation_id": {"type": "string"},
        "trace_id": {"type": "string"}
      }
    }
  }
}
